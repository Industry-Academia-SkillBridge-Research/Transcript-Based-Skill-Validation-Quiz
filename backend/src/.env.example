# MySQL Database Configuration
# Copy this file to .env and replace 'your_password' with actual password
# Use dedicated skillbridge_user (not root) for production

# Production (recommended)
DATABASE_URL=mysql+pymysql://skillbridge_user:your_password@localhost:3306/skillbridge_db?charset=utf8mb4

# Development (alternative - not recommended for production)
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/skillbridge_db?charset=utf8mb4
